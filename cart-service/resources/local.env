SERVER_NAME=cart-service
SERVER_VERSION=1.0
SERVER_HTTP_PORT=7032
SERVER_HTTP_BASE_PATH=/is/v1/cart-service

## Heath check
HEALTH_CHECK_GR_RUNNING_THRESHOLD=100
HEALTH_CHECK_GC_PAUSE_THRESHOLD_MS=10

## Tracing, ignore if not enabled
TRACE_ENDPOINT=10.148.0.7:4318

## Logging
LOG_LEVEL=info
# LOG_LEVEL=debug

KAFKA_BROKERS=10.148.0.7:9092
KAFKA_TLS_ENABLED=false
KAFKA_TLS_SKIP_VERIFY=true 
KAFKA_CA_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=
KAFKA_CLIENT_CERT_FILE=
KAFKA_SASL_ENABLED=false
KAFKA_SASL_ALGORITHM=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMERGROUP=cart-service
KAFKA_HANDLER_POOL=500
# CDC TOPICS
PRODUCT_SERVICE_TOPIC=cdc-product-service.public.PRODUCT
# OUTBOX TOPICS
ORDER_SERVICE_OUTBOX_TOPIC=cdc-order-service.public.OUTBOX
PRODUCT_SERVICE_OUTBOX_TOPIC=cdc-product-service.public.OUTBOX
# SELF TOPICS
CART_TOPIC= CART_TOPIC
CART_ITEM_TOPIC=cdc-cart-service.public.CART_ITEM

## REDIS SERVER
REDIS_SERVER_PREFIX=REDIS-

## RE
REDIS_ADDRESSES=10.148.0.7:6379
REDIS_USERNAME=
REDIS_PASSWORD=

## POSTGRES
POSTGRES_HOST=10.148.0.7
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=cart
POSTGRES_POOL_IDLE_CONNECTION=10
POSTGRES_MAX_POOL_SIZE=30
POSTGRES_IDLE_TIMEOUT=1
POSTGRES_MAX_LIFE_TIME=3

## MONGO
MONGO_HOST=10.148.0.7
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=example
MONGO_DBNAME=cart