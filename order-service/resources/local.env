SERVER_NAME=order-service
SERVER_VERSION=1.0
SERVER_HTTP_PORT=7005
SERVER_HTTP_BASE_PATH=/is/v1/order-service

## Heath check
HEALTH_CHECK_GR_RUNNING_THRESHOLD=100
HEALTH_CHECK_GC_PAUSE_THRESHOLD_MS=10

## Tracing, ignore if not enabled
TRACE_ENDPOINT=10.96.20.152:4318

## Logging
# LOG_LEVEL=info
LOG_LEVEL=debug

KAFKA_BROKERS=34.143.206.13:9092
KAFKA_TLS_ENABLED=false
KAFKA_TLS_SKIP_VERIFY=true 
KAFKA_CA_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=
KAFKA_CLIENT_CERT_FILE=
KAFKA_SASL_ENABLED=false
KAFKA_SASL_ALGORITHM=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMERGROUP=order-service-local
KAFKA_HANDLER_POOL=500
# CDC TOPICS
PRODUCT_SERVICE_TOPIC=cdc-product-service.public.PRODUCT
# OUTBOX TOPICS
ORDER_SERVICE_OUTBOX_TOPIC=cdc-order-service.public.OUTBOX
PRODUCT_SERVICE_OUTBOX_TOPIC=cdc-product-service.public.OUTBOX
CART_SERVICE_OUTBOX_TOPIC=cdc-cart-service.public.OUTBOX
# REVERT TOPICS
CART_TOPIC=CART_TOPIC
# OWN TOPIC
ORDER_TOPIC=ORDER_TOPIC

## REDIS SERVER
REDIS_SERVER_PREFIX=REDIS-

## RE
REDIS_ADDRESSES=34.143.206.13:6379
REDIS_USERNAME=
REDIS_PASSWORD=

## POSTGRES
POSTGRES_HOST=34.143.206.13
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=orderr
POSTGRES_POOL_IDLE_CONNECTION=10
POSTGRES_MAX_POOL_SIZE=30
POSTGRES_IDLE_TIMEOUT=1
POSTGRES_MAX_LIFE_TIME=3